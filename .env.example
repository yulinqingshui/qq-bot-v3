# ============================================================
#  .env — 密钥配置（绝不提交到版本库）
#  复制为 .env 后填写：cp .env.example .env
#  格式：KEY=VALUE（值可用引号包裹）
# ============================================================

# 远程 LLM API Key（llm.backend=remote 时生效；兼容旧名 DEEPSEEK_API_KEY）
REMOTE_API_KEY=

# 本地 LLM API Key（llm.backend=local 且服务端需要鉴权时生效，如 vLLM --api-key）
LLM_API_KEY=
